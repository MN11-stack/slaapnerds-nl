{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "slaapnerds.nl"
        }
      ],
      "destination": "https://www.slaapnerds.nl/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "slaapnerds.nl"
        }
      ],
      "destination": "https://www.slaapnerds.nl/:path+/",
      "permanent": true
    }
  ]
}
